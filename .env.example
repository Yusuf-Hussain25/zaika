# ---------------------------------------------------------------------------
# Zaika configuration. Copy to .env and fill in. Never commit .env.
# Server-only values have plain names; anything the browser needs starts with VITE_.
# ---------------------------------------------------------------------------

# Neon Postgres connection string (pooled).
# Neon console -> your project -> Connect -> copy the "postgresql://..." string.
# (Vercel: Storage -> your Neon database -> .env.local tab -> DATABASE_URL)
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Any long random string, used to sign login tokens.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Optional: enables card payments through Stripe Checkout (test mode is fine).
# Stripe dashboard -> Developers -> API keys -> Secret key (sk_test_...).
# Leave empty to offer cash on delivery only.
STRIPE_SECRET_KEY=""

# Optional: public URL of the site, used for Stripe redirects in production.
# APP_URL="https://zaika.vercel.app"

# ---------------------------------------------------------------------------
# Dish photos (admin panel)
# cloudinary = upload from your device to an UNSIGNED preset (no secret in the browser)
# url        = paste a link to an image that is already online
# Cloudinary console -> Settings (gear) -> Upload -> Upload presets -> Add upload preset:
#   name: zaika_unsigned, Signing mode: Unsigned, Asset folder: zaika
VITE_UPLOAD_PROVIDER="cloudinary"
VITE_CLOUDINARY_CLOUD_NAME="your-cloud-name"
VITE_CLOUDINARY_UPLOAD_PRESET="zaika_unsigned"
VITE_CLOUDINARY_FOLDER="zaika"
